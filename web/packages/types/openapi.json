                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Return API health status.\n\nReports whether the engine fully started and whether the SQLite\nstores are available for querying.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EpisodeDetail": {
        "properties": {
          "episode_id": {
            "type": "string",
            "title": "Episode Id"
          },
          "task_name": {
            "type": "string",
            "title": "Task Name"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "step_count": {
            "type": "integer",
            "title": "Step Count",
            "default": 0
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms",
            "default": 0.0
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "started_at": {
            "type": "number",
            "title": "Started At",
            "default": 0.0
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "sandbox_id": {
            "type": "string",
            "title": "Sandbox Id",
            "default": ""
          },
          "is_complete": {
            "type": "integer",
            "title": "Is Complete",
            "default": 1
          },
          "steps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Steps",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "episode_id",
          "task_name",
          "outcome"
        ],
        "title": "EpisodeDetail",
        "description": "Full episode detail including sandbox info and step data."
      },
      "EpisodeSummary": {
        "properties": {
