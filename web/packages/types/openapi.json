          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/telemetry/{run_id}": {
      "get": {
        "tags": [
          "telemetry"
        ],
        "summary": "Get Telemetry Run",
        "description": "Get telemetry run detail with raw metric samples.",
        "operationId": "get_telemetry_run_api_telemetry__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
