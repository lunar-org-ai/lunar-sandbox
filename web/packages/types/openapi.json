              }
            }
          }
        }
      }
    },
    "/api/telemetry": {
      "get": {
        "tags": [
          "telemetry"
        ],
        "summary": "List Telemetry Runs",
        "description": "List telemetry runs with pagination.",
        "operationId": "list_telemetry_runs_api_telemetry_get",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
