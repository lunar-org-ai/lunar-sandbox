{
  "openapi": "3.1.0",
  "info": {
    "title": "LunarEngine API",
    "description": "REST API for the Lunar Sandbox evaluation engine",
    "version": "0.1.0"
  },
  "paths": {
    "/api/episodes": {
      "get": {
        "tags": [
          "episodes"
        ],
        "summary": "List Episodes",
        "description": "List episodes with optional filters and pagination.\n\nSupports filtering by task_name, outcome, date range (date_from/date_to\nas unix timestamps), and minimum score.  Results can be sorted by any\nepisode field using sort_by and sort_order (\"asc\" or \"desc\").",
        "operationId": "list_episodes_api_episodes_get",
        "parameters": [
          {
            "name": "task_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Task Name"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Outcome"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date From"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date To"
            }
          },
          {
            "name": "score_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Score Min"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "started_at",
              "title": "Sort By"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "desc",
              "title": "Sort Order"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Zero-based offset",
              "default": 0,
              "title": "Offset"
            },
            "description": "Zero-based offset"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Max items to return",
              "default": 20,
              "title": "Limit"
            },
            "description": "Max items to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEpisodes"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/episodes/{episode_id}": {
      "get": {
        "tags": [
          "episodes"
        ],
        "summary": "Get Episode",
        "description": "Get full episode detail including steps.",
        "operationId": "get_episode_api_episodes__episode_id__get",
        "parameters": [
          {
            "name": "episode_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Episode Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EpisodeDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Launch Run",
        "description": "Launch an evaluation run and return IDs immediately.\n\nWhen the engine pool is unavailable (e.g., on macOS), returns mock\nIDs so the dashboard can be developed without a running engine.",
        "operationId": "launch_run_api_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunLaunchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sandboxes": {
      "get": {
        "tags": [
          "sandboxes"
        ],
        "summary": "Get Pool Status",
        "description": "Return current sandbox pool status.\n\nReturns a graceful response when the engine pool is not available\n(e.g., on macOS where Linux kernel features are required).",
        "operationId": "get_pool_status_api_sandboxes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/sandboxes/{sandbox_id}": {
      "get": {
        "tags": [
          "sandboxes"
        ],
        "summary": "Get Sandbox",
        "description": "Return detail for a single sandbox by ID.\n\nWhen the engine pool is unavailable (e.g., on macOS), returns mock\nsandbox data so the dashboard can be developed without a running engine.",
        "operationId": "get_sandbox_api_sandboxes__sandbox_id__get",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SandboxInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sandboxes/{sandbox_id}/stop": {
      "post": {
        "tags": [
          "sandboxes"
        ],
        "summary": "Stop Sandbox",
        "description": "Stop a running sandbox.\n\nWhen the engine pool is unavailable (e.g., on macOS), returns a\ngraceful mock response indicating the sandbox was stopped.",
        "operationId": "stop_sandbox_api_sandboxes__sandbox_id__stop_post",
        "parameters": [
          {
            "name": "sandbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sandbox Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Stop Sandbox Api Sandboxes  Sandbox Id  Stop Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "List Tasks",
        "description": "List tasks that have been evaluated (from episode history).",
        "operationId": "list_tasks_api_tasks_get",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Zero-based offset",
              "default": 0,
              "title": "Offset"
            },
            "description": "Zero-based offset"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Max items to return",
              "default": 20,
              "title": "Limit"
            },
            "description": "Max items to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedTasks"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_name}": {
      "get": {
        "tags": [
          "tasks"
        ],
        "summary": "Get Task",
